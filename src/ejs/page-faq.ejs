<% baseUrlPath='.' ; ejsPath='.' ; pageData="faq" %>
<!DOCTYPE html>
<html lang="ja">
  <!-- prettier-ignore -->
  <%- include(ejsPath + '/common/_head' ,{ baseUrl: baseUrlPath, page:
  json[pageData] }) %>

  <body>
    <!-- ヘッダー -->
    <header class="l-header">
      <!-- prettier-ignore -->
      <%- include(ejsPath + '/common/_p-header' ) %>
    </header>

    <main>
      <!-- 下層ページのメインビュー -->
      <!-- prettier-ignore -->
      <%- include(ejsPath + '/project/_p-sub-mv', { pageTitle: 'FAQ', imagePathDesktop: './assets/images/common/faq-mv.webp', imagePathMobile: './assets/images/common/faq-mv-sp.jpg', altText: ''}) %>

      <!-- パンくず -->
      <% const breadcrumbsKey = "faq"; %>
      <div class="l-breadcrumb">
        <%- include(ejsPath + '/component/_c-breadcrumb' , { breadcrumbsKey, modifier: ""}) %>
      </div>

      <!-- アコーディオン -->
      <div class="l-faq-accordion">
        <%- include(ejsPath + '/project/_p-accordion-items') %>
      </div>
      <!-- Contact -->
      <div class="l-contact l-contact--faq">
        <!-- prettier-ignore -->
        <%- include(ejsPath + '/project/_p-contact') %>
      </div>

      <!-- トップへ戻るボタン -->
      <!-- prettier-ignore -->
      <%- include(ejsPath + '/component/_c-to-top', {link:'#top'}) %>
    </main>

    <!-- フッター -->
    <footer class="l-footer">
      <!-- prettier-ignore -->
      <%- include(ejsPath + '/common/_p-footer' ) %>
    </footer>
  </body>
</html>