<% baseUrlPath='.' ; ejsPath='.' ; pageData="top" %>
<!DOCTYPE html>
<html lang="ja">
  <%- include(ejsPath + '/common/_head' ,{ baseUrl: baseUrlPath, page:
  json[pageData] }) %>
  <!-- css -->
  <!-- <link rel="stylesheet" href="../../dist/assets/css/style.css" /> -->
  <!-- <link rel="stylesheet" href="/assets/css/style.css" /> -->
  <link rel="stylesheet" href="<%= baseUrlPath %>/assets/css/style.css" />
  <style>
    .wrapper {
      max-width: 1000px;
      width: 100%;
      margin: auto;
    }
    /* div {
      margin: 40px 0;
    } */
    .h2 {
      margin-top: 75px;
      background-color: yellow;
      color: black;
    }
    .p {
      margin-top: 10px;
      margin-bottom: 20px;
      color: gray;
    }
  </style>
  <body>
    <div class="wrapper">
      <h2 class="h2">.p-header</h2>
      <p class="p">ヘッダー</p>
      <!-- prettier-ignore -->
      <%- include(ejsPath + '/common/_p-header' ) %>

      <h2 class="h2">.c-title</h2>
      <p class="p">セクションタイトル</p>
      <!-- prettier-ignore -->
      <%- include(ejsPath + '/tutorial/component/_c-title' ,{color:'blue', title:'ここ変えてみる'}) %>
      <!-- prettier-ignore -->
      <%- include(ejsPath + '/tutorial/component/_c-title' ,{color:'pink', title:'カードブロック'}) %>
      <!-- prettier-ignore -->
      <%- include(ejsPath + '/tutorial/component/_c-title' ,{color:'black', title:'カードブロック'}) %>
      <!-- prettier-ignore -->
      <%- include(ejsPath + '/tutorial/component/_c-title' ,{color:'white', title:'カードブロック'}) %>

      <h2 class="h2">.p-footer</h2>
      <p class="p">フッター</p>
      <footer class="l-footer">
        <!-- prettier-ignore -->
        <%- include(ejsPath + '/common/_p-footer' ) %>
      </footer>
      <h2 class="h2">.c-campaign-tab</h2>
      <p class="p">キャンペーンページのタブ</p>
      <!-- prettier-ignore -->
      <%- include(ejsPath + '/component/_c-campaign-tab' ,{link:'#',title:'all'}) %>
      <!-- prettier-ignore -->
      <h2 class="h2">.p-campaign-tabs</h2>
      <p class="p">キャンペーンページのタブリスト</p>
      <!-- prettier-ignore -->
      <%- include(ejsPath + '/project/_p-campaign-tabs') %>
      <!-- prettier-ignore -->
      <h2 class="h2">.c-sidebar-title</h2>
      <p class="p">サイドバータイトル</p>
      <!-- prettier-ignore -->
      <%- include(ejsPath + '/component/_c-sidebar-title',{title:'人気記事'}) %>
      <h2 class="h2">.c-breadcrumb</h2>
      <p class="p">パンくず</p>
      <!-- prettier-ignore -->
      <%
      const breadcrumbsKey = "diving"; // ここのキーを変更すると出し分けできます(キーは_c-breadcrumb.ejsファイルに記載)
      %>
      <!-- prettier-ignore -->
      <%- include(ejsPath + '/component/_c-breadcrumb', { breadcrumbsKey }) %>
      <!-- prettier-ignore -->
      <h2 class="h2">.c-contact-logo</h2>
      <p class="p">コンタクトセクションのロゴ</p>
      <!-- prettier-ignore -->
      <%- include(ejsPath + '/component/_c-contact-logo', { 
        imagePath: 'path/to/image.png', 
        altText: 'ロゴの説明',
        imageWidth: 100,
        imageHeight: 50 
      }) %>
      <!-- prettier-ignore -->
      <h2 class="h2">.c-button</h2>
      <p class="p">ボタン</p>
      <!-- prettier-ignore -->
      <%- include(ejsPath + '/component/_c-button', {link:'#', text:'View more', modifier: ""}) %>
      <h2 class="h2">.c-section-header</h2>
      <p class="p">セクションタイトル</p>
      <!-- prettier-ignore -->
      <%- include(ejsPath + '/component/_c-section-header', {engTitle: "Blog", jaTitle: "ブログ", modifier: "white-pc"}) %>
      <!-- prettier-ignore -->
      <h2 class="h2">.c-pagenavi</h2>
      <p class="p">ページネーション</p>
      <!-- prettier-ignore -->
      <%- include(ejsPath + '/component/_c-pagenavi') %>
      <h2 class="h2">.c-diving-information-tab</h2>
      <p class="p">ダイビング情報ページのタブ</p>
      <!-- prettier-ignore -->
      <%- include(ejsPath + '/component/_c-diving-information-tab' ,{link: '#', 
      imgDefault:'./assets/images/common/information-tab-green.png', imgDefaultAlt:'クジラの画像', 
      imgHover: './assets/images/common/information-tab-white.png',
      imgHoverAlt: 'クジラの画像', 
      title1: 'ライセンス', 
      title2: '講習' }) %>
      <!-- prettier-ignore -->
      <h2 class="h2">.p-diving-information-tabs</h2>
      <p class="p">ダイビング情報ページのタブリスト</p>
      <!-- prettier-ignore -->
      <%- include(ejsPath + '/project/_p-diving-information-tabs') %>
      <!-- prettier-ignore -->
      <h2 class="h2">.c-right-facing-fish</h2>
      <p class="p">ページ共通さかなの装飾(右向き)</p>
      <!-- prettier-ignore -->
      <div style="margin-bottom: 150px;" class="c-right-facing-fish"></div>
      <!-- prettier-ignore -->
      <h2 class="h2">.c-to-top</h2>
      <p class="p">トップに戻るボタン</p>
      <!-- prettier-ignore -->
      <%- include(ejsPath + '/component/_c-to-top', {link:'#top'}) %>
      <h2 class="h2">.c-left-facing-fish</h2>
      <p class="p">ページ共通さかなの装飾(左向き)</p>
      <!-- prettier-ignore -->
      <div style="margin-bottom: 150px;" class="c-left-facing-fish"></div>
      <!-- prettier-ignore -->
      <h2 class="h2">.p-blog-card</h2>
      <p class="p">ブログカード</p>
      <!-- prettier-ignore -->
      <%- include(ejsPath + '/project/_p-blog-card', { time: '2023.11/17', title: 'ライセンス取得', text: 'ここにテキストが入ります。ここにテキストが入ります。ここにテキストが入ります。ここにテキストが入ります。<br />ここにテキストが入ります。ここにテキストが入ります。ここにテキスト',
      imagePath: './assets/images/common/Blog1.jpg'}) %>
      <!-- prettier-ignore -->
      <h2 class="h2">.p-blog-cards</h2>
      <p class="p">ブログカード群</p>
      <!-- prettier-ignore -->
      <%- include(ejsPath + '/project/_p-blog-cards') %>
      <!-- prettier-ignore -->
      <h2 class="h2">.p-blog-cards-sub</h2>
      <p class="p">ブログリスト（ブログ一覧ページ）</p>
      <!-- prettier-ignore -->
      <%- include(ejsPath + '/project/_p-blog-cards-sub') %>
      <!-- prettier-ignore -->
      <h2 class="h2">.p-blog</h2>
      <p class="p">ブログセクション（トップページ）</p>
      <!-- prettier-ignore -->
      <%- include(ejsPath + '/project/_p-blog') %>
      <!-- prettier-ignore -->
      <h2 class="h2">.p-mv</h2>
      <p class="p">メインビュー</p>
      <!-- prettier-ignore -->
      <%- include(ejsPath + '/project/_p-mv') %>
      <!-- prettier-ignore -->
      <h2 class="h2">.p-sub-mv</h2>
      <p class="p">下層ページトップ</p>
      <!-- prettier-ignore -->
      <%- include(ejsPath + '/project/_p-sub-mv', { pageTitle: 'Campaign', imagePathDesktop: './assets/images/common/sub-campaign-mv.jpg', imagePathMobile: './assets/images/common/sub-campaign-mv-sp.jpg', altText: '二匹の黄色い魚が泳いでいる様子'}) %>
      <!-- prettier-ignore -->
      <h2 class="h2">.p-voice-card</h2>
      <p class="p">お客様の声のカード</p>
      <!-- prettier-ignore -->
      <%- include(ejsPath + '/project/_p-voice-card', { age: '20代(女性)', category: 'ライセンス講習', title: 'ここにタイトルが入ります。ここにタイトル', imagePath: './assets/images/common/Voice1.webp', text: 'ここにテキストが入ります。ここにテキストが入ります。ここにテキストが入ります。ここにテキストが入ります。<br />ここにテキストが入ります。ここにテキストが入ります。ここにテキストが入ります。ここにテキストが入ります。ここにテキストが入ります。ここにテキストが入ります。ここにテキストが入ります。<br />ここにテキストが入ります。ここにテキストが入ります。'})
      %>
      <h2 class="h2">.p-voice-cards</h2>
      <p class="p">お客様の声のカード群</p>
      <!-- prettier-ignore -->
      <%- include(ejsPath + '/project/_p-voice-cards') %>
      <h2 class="h2">.p-footer-nav</h2>
      <p class="p">フッターナビゲーション</p>
      <!-- prettier-ignore -->
      <%- include(ejsPath + '/project/_p-footer-nav') %>
      <!-- prettier-ignore -->
      <h2 class="h2">.p-single__content</h2>
      <p class="p">シングルページコンテンツ</p>
      <!-- prettier-ignore -->
      <%- include(ejsPath + '/project/_p-single-content') %>
      <!-- prettier-ignore -->
      <h2 class="h2">.p-contact</h2>
      <p class="p">ページ共通コンタクトセクション</p>
      <!-- prettier-ignore -->
      <%- include(ejsPath + '/project/_p-contact') %>
      <!-- prettier-ignore -->
      <h2 class="h2">.p-accordion-item</h2>
      <p class="p">よくある質問アコーディオンパーツ</p>
      <!-- prettier-ignore -->
      <%- include(ejsPath + '/project/_p-accordion-item') %>
      <!-- prettier-ignore -->
      <h2 class="h2">.p-accordion-items</h2>
      <p class="p">よくある質問リスト</p>
      <!-- prettier-ignore -->
      <%- include(ejsPath + '/project/_p-accordion-items') %>
      <!-- prettier-ignore -->
      <h2 class="h2">.p-sp-nav</h2>
      <p class="p">ドロワーメニュー</p>
      <!-- prettier-ignore -->
      <%- include(ejsPath + '/project/_p-sp-nav') %>
      <h2 class="h2">.p-pc-nav</h2>
      <p class="p">グローバルナビゲーション</p>
      <!-- prettier-ignore -->
      <%- include(ejsPath + '/project/_p-pc-nav') %>
      <!-- prettier-ignore -->
      <h2 class="h2">.p-privacy-policy-contents</h2>
      <p class="p">プライバシーポリシーコンテンツ</p>
      <!-- prettier-ignore -->
      <%- include(ejsPath + '/project/_p-privacy-policy-contents', {
        title: "プライバシーポリシー",
        items: [
          { text: "以下は、Webサイトで使用するための一般的なプライバシーポリシーの例です。" },
          { 
            numbers: [
              "1.概要 当社は、お客様の個人情報を大切に扱い、個人情報保護に努めています。",
              "2.収集する情報 当社は、お客様が当社のサービスを利用する際に、お名前、住所、電話番号、メールアドレスなどの個人情報を収集する場合があります。"
            ]
          }
        ]
      }) %>

      <!-- prettier-ignore -->
    </div>
  </body>
</html>
