<% baseUrlPath='.' ; ejsPath='.' ; pageData="top" %>
<!DOCTYPE html>
<html lang="ja">
  <%- include(ejsPath + '/common/_head' ,{ baseUrl: baseUrlPath, page: json[pageData] }) %>
  <!-- css -->
  <!-- <link rel="stylesheet" href="../../dist/assets/css/style.css" /> -->
  <!-- <link rel="stylesheet" href="/assets/css/style.css" /> -->
  <link rel="stylesheet" href="<%= baseUrlPath %>/assets/css/style.css" />
  <style>
    .wrapper {
      max-width: 1000px;
      width: 100%;
      margin: auto;
    }
    /* div {
      margin: 40px 0;
    } */
    .h2 {
      margin-top: 75px;
      background-color: yellow;
      color: black;
    }
    .p {
      margin-top: 10px;
      margin-bottom: 20px;
      color: gray;
    }
  </style>
  <body>
    <div class="wrapper">
      <h2 class="h2">header</h2>
      <p class="p">ヘッダー</p>
      <%- include(ejsPath + '/common/_header' ) %>

      <h2 class="h2">.c-title</h2>
      <p class="p">セクションタイトル</p>
      <!-- prettier-ignore -->
      <%- include(ejsPath + '/tutorial/component/_c-title' ,{color:'blue', title:'ここ変えてみる'}) %>
      <!-- prettier-ignore -->
      <%- include(ejsPath + '/tutorial/component/_c-title' ,{color:'pink', title:'カードブロック'}) %>
      <!-- prettier-ignore -->
      <%- include(ejsPath + '/tutorial/component/_c-title' ,{color:'black', title:'カードブロック'}) %>
      <!-- prettier-ignore -->
      <%- include(ejsPath + '/tutorial/component/_c-title' ,{color:'white', title:'カードブロック'}) %>

      <h2 class="h2">.footer</h2>
      <p class="p">フッター</p>
      <%- include(ejsPath + '/common/_footer' ) %>
      <h2 class="h2">.c-campaign-tab</h2>
      <p class="p">キャンペーンページのタブ</p>
      <!-- prettier-ignore -->
      <%- include(ejsPath + '/component/_c-campaign-tab' ,{link:'#',title:'all'}) %>
      <!-- prettier-ignore -->
      <%- include(ejsPath + '/component/_c-campaign-tab',{link:'#', title:'ライセンス講習'}) %>
      <h2 class="h2">.c-sidebar-title</h2>
      <p class="p">サイドバータイトル</p>
      <!-- prettier-ignore -->
      <%- include(ejsPath + '/component/_c-sidebar-title',{title:'人気記事'}) %>
      <h2 class="h2">.c-breadcrumb</h2>
      <p class="p">パンくず</p>
      <!-- prettier-ignore -->
      <%
      const breadcrumbsKey = "diving"; // ここのキーを変更すると出し分けできます(キーは_c-breadcrumb.ejsファイルに記載)
      %>
      <%- include(ejsPath + '/component/_c-breadcrumb', { breadcrumbsKey }) %>
      <!-- prettier-ignore -->
      <h2 class="h2">.c-button</h2>
      <p class="p">ボタン</p>
      <%- include(ejsPath + '/component/_c-button', {link:'#', text:'View more'}) %>
      <!-- prettier-ignore -->
      <h2 class="h2">.c-section-header</h2>
      <p class="p">セクションタイトル</p>
      <%
      const sectionKey = "campaign"; // ここでキーを指定することで対応するセクションタイトルが出力されます
      %>
      <!-- prettier-ignore -->
      <%- include(ejsPath + '/component/_c-section-header', { sectionKey }) %>
      <!-- prettier-ignore -->
      <h2 class="h2">.c-pagenavi</h2>
      <p class="p">ページネーション</p>
      <!-- prettier-ignore -->
      <%- include(ejsPath + '/component/_c-pagenavi') %>
      <h2 class="h2">.c-diving-information-tab</h2>
      <p class="p">ダイビング情報ページのタブ</p>
      <!-- prettier-ignore -->
      <!-- prettier-ignore -->
      <%- include(ejsPath + '/component/_c-diving-information-tab' ,{link:'#',title:'<span class="c-diving-information-tab__break">ライセンス</span><span class="c-diving-information-tab__break">講習</span>'}) %>
      <!-- prettier-ignore -->
      <h2 class="h2">.c-right-facing-fish</h2>
      <p class="p">ページ共通さかなの装飾(右向き)</p>
      <!-- prettier-ignore -->
      <%- include(ejsPath + '/component/_c-right-facing-fish' ,{}) %>
      <!-- prettier-ignore -->
      <h2 class="h2">.c-to-top</h2>
      <p class="p">トップに戻るボタン</p>
      <%- include(ejsPath + '/component/_c-to-top', {link:'#top'}) %>
    </div>
  </body>
</html>
