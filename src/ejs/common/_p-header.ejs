<% var isTopPage = (typeof isTopPage !== 'undefined') ? isTopPage : false; %>

<div class="p-header js-header">
  <div class="p-header__inner">
    <!-- prettier-ignore -->
    <% if (isTopPage) { %>
      <h1 class="p-header__logo">
    <!-- prettier-ignore -->
    <% } else { %>
      <div class="p-header__logo">
    <!-- prettier-ignore -->
    <% } %>
        <a href="./" class="p-header__logo-link">
          <picture>
            <source media="(max-width: 767px)" srcset="./assets/images/common/logo-sp.svg">
            <img src="./assets/images/common/logo.svg" alt="CodeUps">
          </picture>
        </a>
    <!-- prettier-ignore -->
    <% if (isTopPage) { %>
      </h1>
    <!-- prettier-ignore -->
    <% } else { %>
      </div>
    <!-- prettier-ignore -->
    <% } %>

    <div class="p-header__drawer">
      <!-- prettier-ignore -->
      <%- include(ejsPath + './component/_c-hamburger') %>
    </div>
    <div class="p-header__pc-nav">
      <!-- prettier-ignore -->
      <%- include(ejsPath + './project/_p-pc-nav', {
        navItems: [
          { url: './archive-campaign.html', eng: 'Campaign', ja: 'キャンペーン' },
          { url: './page-about.html', eng: 'About&nbsp;us', ja: '私たちについて' },
          { url: './page-diving-info.html', eng: 'Information', ja: 'ダイビング情報' },
          { url: './home.html', eng: 'Blog', ja: 'ブログ' },
          { url: './archive-voices.html', eng: 'Voice', ja: 'お客様の声' },
          { url: './page-price.html', eng: 'Price', ja: '料金一覧' },
          { url: './page-faq.html', eng: 'FAQ', ja: 'よくある質問' },
          { url: './page-contact.html', eng: 'Contact', ja: 'お問い合わせ' },
        ]
      }) %>
    </div>
    <div class="p-header__sp-nav">
      <!-- prettier-ignore -->
      <%- include(ejsPath + './project/_p-sp-nav') %>
    </div>
  </div>
</div>
