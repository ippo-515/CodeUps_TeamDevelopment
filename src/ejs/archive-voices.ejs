<% baseUrlPath='.' ; ejsPath='.' ; pageData="voices" %>
<!DOCTYPE html>
<html lang="ja">
  <!-- prettier-ignore -->
  <%- include(ejsPath + '/common/_head' ,{ baseUrl: baseUrlPath, page:
  json[pageData] }) %>

  <body>
    <!-- ヘッダー -->
    <header class="l-header">
      <!-- prettier-ignore -->
      <%- include(ejsPath + '/common/_p-header' ) %>
    </header>

    <main>
      <!-- 下層ページのメインビュー -->
      <!-- prettier-ignore -->
      <%- include(ejsPath + '/project/_p-sub-mv', { pageTitle: 'Voice', imagePathDesktop: './assets/images/common/sub-voice-mv.webp', imagePathMobile: './assets/images/common/sub-voice-mv-sp.jpg', altText: ''}) %>

      <!-- パンくず -->
      <!-- prettier-ignore -->
      <% const breadcrumbsKey = "reviews"; %>
      <div class="l-breadcrumb">
        <!-- prettier-ignore -->
        <%- include(ejsPath + '/component/_c-breadcrumb' , { breadcrumbsKey, modifier: ""}) %>
      </div>

      <!-- お客様の声 -->
      <div class="l-archive-voices">
        <!-- prettier-ignore -->
        <%- include(ejsPath + '/project/_p-archive-voices') %>
      </div>

      <!-- ページネーション -->
      <div class="l-pagenavi l-pagenavi--mt80">
        <!-- prettier-ignore -->
        <%- include(ejsPath + '/component/_c-pagenavi') %>
      </div>

      <!-- Contact -->
      <div class="l-contact">
        <!-- prettier-ignore -->
        <%- include(ejsPath + '/project/_p-contact') %>
      </div>

      <!-- トップへ戻るボタン -->
      <!-- prettier-ignore -->
      <%- include(ejsPath + '/component/_c-to-top', {link:'#top'}) %>

    </main>

    <!-- フッター -->
    <footer class="l-footer">
      <!-- prettier-ignore -->
      <%- include(ejsPath + '/common/_p-footer' ) %>
    </footer>
  </body>

</html>
