<%
const { engTitle, jaTitle, modifier } = locals || {};
%>

<div class="c-section-header">
  <% if (engTitle) { %>
    <p class="c-section-header__engtitle <%= modifier ? `c-section-header__engtitle--${modifier}` : '' %>"><%= engTitle %></p>
  <% } %>
  <% if (jaTitle) { %>
    <h2 class="c-section-header__jatitle <%= modifier ? `c-section-header__jatitle--${modifier}` : '' %>"><%= jaTitle %></h2>
  <% } %>
</div>