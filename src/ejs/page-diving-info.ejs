<% baseUrlPath='.' ; ejsPath='.' ; pageData="diving" %>
<!DOCTYPE html>
<html lang="ja">
  <!-- prettier-ignore -->
  <%- include(ejsPath + '/common/_head' ,{ baseUrl: baseUrlPath, page:
  json[pageData] }) %>

  <body>
    <!-- ヘッダー -->
    <header class="l-header">
      <!-- prettier-ignore -->
      <%- include(ejsPath + '/common/_p-header' ) %>
    </header>

    <main>
      <!-- 下層ページのメインビュー -->
      <!-- prettier-ignore -->
      <%- include(ejsPath + '/project/_p-sub-mv', { pageTitle: 'Information', imagePathDesktop: './assets/images/common/sub-information-mv.webp', imagePathMobile: './assets/images/common/sub-information-mv-sp.jpg', altText: ''}) %>

      <!-- パンくず -->
      <!-- prettier-ignore -->
      <% const breadcrumbsKey = "diving"; %>
      <div class="l-breadcrumb">
        <!-- prettier-ignore -->
        <%- include(ejsPath + '/component/_c-breadcrumb' , { breadcrumbsKey, modifier: ""}) %>
      </div>

      <!-- ダイビング情報 -->
      <div class="l-diving-tab-switching">
        <!-- prettier-ignore -->
        <%- include(ejsPath + '/project/_p-diving-tab-switching') %>
      </div>

      <!-- Contact -->
      <div class="l-contact l-contact--diving-info">
        <!-- prettier-ignore -->
        <%- include(ejsPath + '/project/_p-contact') %>
      </div>

      <!-- トップへ戻るボタン -->
      <!-- prettier-ignore -->
      <%- include(ejsPath + '/component/_c-to-top', {link:'#top'}) %>
    </main>

    <!-- フッター -->
    <footer class="l-footer">
      <!-- prettier-ignore -->
      <%- include(ejsPath + '/common/_p-footer' ) %>
    </footer>
  </body>
</html>
