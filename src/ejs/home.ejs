<% baseUrlPath='.' ; ejsPath='.' ; pageData="blog" %>
  <!DOCTYPE html>
  <html lang="ja">
  <!-- prettier-ignore -->
  <%- include(ejsPath + '/common/_head' ,{ baseUrl: baseUrlPath, page: json[pageData] }) %>

    <body>
      <!-- ヘッダー -->
      <header class="l-header">
        <!-- prettier-ignore -->
        <%- include(ejsPath + '/common/_p-header' ) %>
      </header>

      <main>
        <!-- 下層ページのメインビュー -->
        <!-- prettier-ignore -->
        <%- include(ejsPath + '/project/_p-sub-mv' , { pageTitle: 'Blog' ,
          imagePathDesktop: './assets/images/common/sub-blog-mv.webp' ,
          imagePathMobile: './assets/images/common/sub-blog-mv-sp.jpg' , altText: '' }) %>

          <!-- パンくず -->
          <% const breadcrumbsKey="blogList" ; %>
            <div class="l-breadcrumb">
              <%- include(ejsPath + '/component/_c-breadcrumb' , { breadcrumbsKey, modifier: "" }) %>
            </div>

            <div class="l-sub-blog-contents">
              <div class="l-sub-blog-contents__inner l-inner">
                <div class="l-sub-blog-contents__wrap">
                  <%- include(ejsPath + '/project/_p-sub-blog-cards' ) %>
                    <div class="l-pagenavi">
                      <%- include(ejsPath + '/component/_c-pagenavi' ) %>
                    </div>
                </div>
                <div class="l-sidebar">
                  <%- include(ejsPath + '/project/_p-sidebar' ) %>
                </div>
              </div>
            </div>
            
            <!-- Contact -->
            <div class="l-contact">
              <!-- prettier-ignore -->
              <%- include(ejsPath + '/project/_p-contact' ) %>
            </div>

            <!-- トップへ戻るボタン -->
            <!-- prettier-ignore -->
            <%- include(ejsPath + '/component/_c-to-top' , {link:'#top'}) %>
      </main>

      <!-- フッター -->
      <footer class="l-footer">
        <!-- prettier-ignore -->
        <%- include(ejsPath + '/common/_p-footer' ) %>
      </footer>
    </body>

  </html>