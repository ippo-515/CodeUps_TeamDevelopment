<% baseUrlPath='.' ; ejsPath='.' ; pageData="top" %>
<!DOCTYPE html>
<html lang="ja">
  <%- include(ejsPath + '/common/_head' ,{ baseUrl: baseUrlPath, page:
  json[pageData] }) %>

  <body>
    <header class="l-header">
      <!-- prettier-ignore -->
      <%- include(ejsPath + '/common/_p-header', { isTopPage: true } ) %>
    </header>
    <section class="l-mv">
      <!-- prettier-ignore -->
      <%- include(ejsPath + '/project/_p-mv') %>
    </section>
    <main>
      <section class="l-campaign-top">
        <!-- prettier-ignore -->
        <%- include(ejsPath + '/project/_p-campaign-top') %>
      </section>
      <section class="l-about-us-top">
        <!-- prettier-ignore -->
        <%- include(ejsPath + '/project/_p-about-us-top') %>
      </section>
      <section class="l-diving-information">
        <!-- prettier-ignore -->
        <%- include(ejsPath + '/project/_p-diving-information') %>
      </section>
      <section class="l-blog">
        <!-- prettier-ignore -->
        <%- include(ejsPath + '/project/_p-blog') %>
      </section>
      <section class="l-voice">
        <!-- prettier-ignore -->
        <%- include(ejsPath + '/project/_p-voice') %>
      </section>
      <section class="l-fee-top">
        <!-- prettier-ignore -->
        <%- include(ejsPath + '/project/_p-fee-top') %>
      </section>
      <section class="l-contact l-contact--top">
        <!-- prettier-ignore -->
        <%- include(ejsPath + '/project/_p-contact') %>
      </section>
      <!-- トップへ戻るボタン -->
      <!-- prettier-ignore -->
      <%- include(ejsPath + '/component/_c-to-top', {link:'#top'}) %>
    </main>
    <footer class="l-footer">
      <!-- prettier-ignore -->
      <%- include(ejsPath + '/common/_p-footer' ) %>
    </footer>
  </body>
</html>
