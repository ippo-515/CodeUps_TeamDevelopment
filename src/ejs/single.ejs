<% baseUrlPath='.' ; ejsPath='.' ; pageData="single" %>
  <!DOCTYPE html>
  <html lang="ja">
  <!-- prettier-ignore -->
  <%- include(ejsPath + '/common/_head' ,{ baseUrl: baseUrlPath, page: json[pageData] }) %>

    <body>
      <!-- ヘッダー -->
      <header class="l-header">
        <!-- prettier-ignore -->
        <%- include(ejsPath + '/common/_p-header' ) %>
      </header>

      <main>
        <!-- 下層ページのメインビュー -->
        <!-- prettier-ignore -->
        <%- include(ejsPath + '/project/_p-sub-mv' , { pageTitle: 'Blog' ,
          imagePathDesktop: './assets/images/common/sub-blog-mv.webp' ,
          imagePathMobile: './assets/images/common/sub-blog-mv-sp.jpg' , altText: '' }) %>

          <!-- パンくず -->
          <% const breadcrumbsKey="blogDetail" ; %>
            <div class="l-breadcrumb">
              <%- include(ejsPath + '/component/_c-breadcrumb' , { breadcrumbsKey, modifier: "" }) %>
            </div>

            <!-- ブログ詳細コンテンツ -->
            <div class="l-single-contents">
              <%- include(ejsPath + '/project/_p-single-contents' ) %>
            </div>

            <!-- Contact -->
            <div class="l-contact l-contact--single">
              <!-- prettier-ignore -->
              <%- include(ejsPath + '/project/_p-contact' ) %>
            </div>

            <!-- トップへ戻るボタン -->
            <!-- prettier-ignore -->
            <%- include(ejsPath + '/component/_c-to-top' , {link:'#top'}) %>
      </main>

      <!-- フッター -->
      <footer class="l-footer">
        <!-- prettier-ignore -->
        <%- include(ejsPath + '/common/_p-footer' ) %>
      </footer>
    </body>

  </html>