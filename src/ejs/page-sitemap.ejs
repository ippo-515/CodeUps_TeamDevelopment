<% baseUrlPath='.' ; ejsPath='.' ; pageData="sitemap" %>
<!DOCTYPE html>
<html lang="ja">
  <!-- prettier-ignore -->
  <%- include(ejsPath + '/common/_head' ,{ baseUrl: baseUrlPath, page:
  json[pageData] }) %>

  <body>
    <!-- ヘッダー -->
    <header class="l-header">
      <!-- prettier-ignore -->
      <%- include(ejsPath + '/common/_p-header' ) %>
    </header>

    <main>
      <!-- 下層ページのメインビュー -->
      <!-- prettier-ignore -->
      <%- include(ejsPath + '/project/_p-sub-mv', { pageTitle: 'Site MAP', imagePathDesktop: './assets/images/common/sitemap-mv.webp', imagePathMobile: './assets/images/common/sitemap-mv-sp.jpg', altText: ''}) %>

      <!-- パンくず -->
      <!-- prettier-ignore -->
      <% const breadcrumbsKey = "sitemap"; %>
      <div class="l-breadcrumb">
        <!-- prettier-ignore -->
        <%- include(ejsPath + '/component/_c-breadcrumb' , { breadcrumbsKey, modifier: ""}) %>
      </div>

      <!-- サイトマップ -->
      <div class="l-page-sitemap">
        <!-- prettier-ignore -->
        <%- include(ejsPath + '/project/_p-page-sitemap') %>
      </div>

      <!-- Contact -->
      <div class="l-contact">
        <!-- prettier-ignore -->
        <%- include(ejsPath + '/project/_p-contact') %>
      </div>

      <!-- トップへ戻るボタン -->
      <!-- prettier-ignore -->
      <%- include(ejsPath + '/component/_c-to-top', {link:'#top'}) %>

    </main>

    <!-- フッター -->
    <footer class="l-footer">
      <!-- prettier-ignore -->
      <%- include(ejsPath + '/common/_p-footer' ) %>
    </footer>
  </body>

</html>