  text: "ここにテキストが入ります。ここにテキストが入ります。ここにテキストが入ります。ここにテキストが入ります。ここにテキストが入ります。ここにテキストが入ります。ここにテキストが入ります。ここにテキストが入ります。ここにテキストが入ります。ここにテキストが入ります。ここにテキストが入ります。ここにテキストが入ります。"
  }, { imageSrc: "./assets/images/common/Blog1.webp" , imageAlt: "ウミガメが泳いでいる様子" ,
  text: "ここにテキストが入ります。ここにテキストが入ります。ここにテキストが入ります。ここにテキストが入ります。ここにテキストが入ります。ここにテキストが入ります。ここにテキストが入ります。ここにテキストが入ります。ここにテキストが入ります。ここにテキストが入ります。ここにテキストが入ります。ここにテキストが入ります。"
  } ]; const singleItems=["リスト1", "リスト2" , "リスト3" ]; const
  paragraphTexts=[ "ここにテキストが入ります。ここにテキストが入ります。ここにテキストが入ります。ここにテキストが入ります。ここにテキストが入ります。ここにテキストが入ります。ここにテキストが入ります。ここにテキストが入ります。ここにテキストが入ります。ここにテキストが入ります。ここにテキストが入ります。ここにテキストが入ります。"
  ]; %>

  <div class="p-single-content">
    <div class="p-single-content__wrap">
        <div class="p-single-content__cards">
          <% blogCards.forEach((card)=> { %>
            <div class="p-single-cards__item">
              <a href="#" class="p-single-card">
                <div class="p-single-card__wrap">
                  <time class="p-single-card__dete" datetime="<%= card.datetime %>">
                    <%= card.dateText %>
                  </time>
                  <p class="p-single-card__title">
                    <%= card.title %>
                  </p>
                </div>
                <div class="p-single-card__img">
                  <img src="<%= card.imageSrc %>" alt="<%= card.imageAlt %>">
                </div>
                <p class="p-single-card__text">
                  <%= card.text %>
                </p>
              </a>
            </div>
            <% }); %>
        </div>
      <ul class="p-single__items">
        <% singleItems.forEach((item)=> { %>
          <li class="p-single__item">
            <%= item %>
          </li>
          <% }); %>
      </ul>
      <% paragraphTexts.forEach((text)=> { %>
        <p class="p-single-card__text">
          <%= text %>
        </p>
        <% }); %>
    </div>
  </div>