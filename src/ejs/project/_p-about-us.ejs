<!-- 有効な画像のリストを定義 -->
<% const validimages = ['coral']; %>

<!-- 有効な画像が指定された場合、その色に応じたクラス名を生成。そうでなければ、空文字列を代入 -->
<% const imgClass = validimages.includes(img) ? ` p-about-us__inner--${img}` :
''; %>

<div class="p-about-us">
  <div class="p-about-us__inner<%- imgClass %> l-inner">
    <div class="p-about-us__img-wrapper">
      <div class="p-about-us__img-left">
        <picture>
          <source
            srcset="./assets/images/common/about1-pc.jpg"
            media="(min-width: 768px)"
          />
          <img
            src="./assets/images/common/about1-sp.jpg"
            alt="シーサーの画像"
          />
        </picture>
      </div>
      <div class="p-about-us__img-right">
        <picture>
          <source
            srcset="./assets/images/common/about2-pc.jpg"
            media="(min-width: 768px)"
          />
          <img src="./assets/images/common/about2-sp.jpg" alt="魚の画像" />
        </picture>
      </div>
    </div>
    <div class="p-about-us__content-wrapper">
      <h3 class="p-about-us__content-title"><%- contentTitle %></h3>
      <div class="p-about-us__text-wrapper">
        <p class="p-about-us__text"><%- text %></p>
        <div class="p-about-us__button">
          <!-- prettier-ignore -->
          <%- include(ejsPath + './component/_c-button', {link:'#', text:'View more'}) %>
        </div>
      </div>
    </div>
  </div>
</div>
