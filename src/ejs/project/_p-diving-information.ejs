<div class="p-diving-information">
  <div class="p-diving-information__inner l-inner">
    <div class="p-diving-information__section-title">
      <!-- prettier-ignore -->
      <%- include(ejsPath + './component/_c-section-header', {engTitle:
    "Information", jaTitle: "ダイビング情報"}) %>
    </div>
    <div class="p-diving-information__contentsWrapper">
      <div class="p-diving-information__img js-colorbox">
        <picture>
          <source
            srcset="./assets/images/common/information1-pc.jpg"
            media="(min-width: 768px)"
          />
          <img
            src="./assets/images/common/information1-sp.jpg"
            alt="魚の画像"
          />
        </picture>
      </div>
      <div class="p-diving-information__contentWrapper">
        <div class="p-diving-information__textWrapper">
          <h3 class="p-diving-information__textTitle">ライセンス講習</h3>
          <p class="p-diving-information__text">
            当店はダイビングライセンス（Cカード）世界最大の教育機関PADIの「正規店」として店舗登録されています。<br />正規登録店として、安心安全に初めての方でも安心安全にライセンス取得をサポート致します。
          </p>
        </div>
        <div class="p-about-us__button">
          <!-- prettier-ignore -->
          <%- include(ejsPath + './component/_c-button', {link:'#', text:'View more'}) %>
        </div>
      </div>
    </div>
  </div>
</div>
