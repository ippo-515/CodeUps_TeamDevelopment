<article class="p-campaign-card">
  <div class="p-campaign-card__img">
    <img src="<%= imagePath %>" alt="<%= imageAlt %>" />
  </div>
  <div class="p-campaign-card__contents">
    <div class="p-campaign-card__top">
      <div class="p-campaign-card__tag"><%= tag %></div>
      <h3 class="p-campaign-card__title"><%= title %></h3>
    </div>
    <div class="p-campaign-card__bottom">
      <p class="p-campaign-card__text"><%= text %></p>
      <div class="p-campaign-card__priceWrapper">
        <p class="p-campaign-card__priceBefore"><%= priceBefore %></p>
        <p class="p-campaign-card__priceAfter"><%= priceAfter %></p>
      </div>
    </div>
  </div>
</article>
