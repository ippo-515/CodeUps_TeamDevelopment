<nav class="p-pc-nav">
  <ul class="p-pc-nav__items">
    <% navItems.forEach(function(item) { %>
      <li class="p-pc-nav__item">
        <a href="<%= item.url %>" class="p-pc-nav__link">
          <span class="p-pc-nav__engtext"><%- item.eng %></span>
          <span class="p-pc-nav__jatext"><%- item.ja %></span>
        </a>
      </li>
    <% }); %>
  </ul>
</nav>
