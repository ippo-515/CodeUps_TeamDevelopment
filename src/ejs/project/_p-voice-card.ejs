<article class="p-voice-card">
  <a href="#" class="p-voice-card__link">
    <div class="p-voice-card__head">
      <div class="p-voice-card__meta">
        <div class="p-voice-card__label">
          <span class="p-voice-card__age"><%= age %></span>
          <p class="p-voice-card__category"><%= category %></p>
        </div>
        <h3 class="p-voice-card__title"><%= title %></h3>
      </div>
      <div class="p-voice-card__img">
        <div class="c-colorbox js-colorbox">
          <img src="<%= imagePath %>" alt="">
        </div>
      </div>
    </div>
    <p class="p-voice-card__text"><%- text %></p>
  </a>
</article>