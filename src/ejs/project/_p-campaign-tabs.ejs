<% project = '.'; tabText = [ {link: '#', title: 'all'}, {link: '#',
title:'ライセンス講習'}, {link: '#', title: 'ファンダイビング'}, {link: '#',
title: '体験ダイビング'}, ] %>

<div class="p-campaign-tabs">
  <ul class="p-campaign-tabs__items">
    <% tabText.forEach(function(tab) { %>
    <li class="p-campaign-tabs__item">
      <%- include(project + './component/_c-campaign-tab', { link: tab.link,
      title: tab.title, }) %>
    </li>
    <% }); %>
  </ul>
</div>
