<!-- prettier-ignore -->
<% const contentText = [
  {
    title: 'ライセンス講習',
    items: [
      { itemTitle: 'オープンウォーターダイバーコース', itemPrice: '¥50,000' },
      { itemTitle: 'アドバンスドオープンウォーターコース', itemPrice: '¥60,000' },
      { itemTitle: 'レスキュー＋EFRコース', itemPrice: '¥70,000' }
    ]
  },
  {
    title: '体験ダイビング',
    items: [
      { itemTitle: 'ビーチ体験ダイビング(半日)', itemPrice: '¥7,000' },
      { itemTitle: 'ビーチ体験ダイビング(1日)', itemPrice: '¥14,000' },
      { itemTitle: 'ボート体験ダイビング(半日)', itemPrice: '¥10,000' },
      { itemTitle: 'ボート体験ダイビング(1日)', itemPrice: '¥18,000' }
    ]
  },
  {
    title: 'ファンダイビング',
    items: [
      { itemTitle: 'ビーチダイビング(2ダイブ)', itemPrice: '¥14,000' },
      { itemTitle: 'ボートダイビング(2ダイブ)', itemPrice: '¥18,000' },
      { itemTitle: 'スペシャルダイビング(2ダイブ)', itemPrice: '¥24,000' },
      { itemTitle: 'ナイトダイビング(1ダイブ)', itemPrice: '¥10,000' }
    ]
  },
  {
    title: 'スペシャルダイビング',
    items: [
      { itemTitle: '貸切ダイビング(2ダイブ)', itemPrice: '¥24,000' },
      { itemTitle: '1日ダイビング(3ダイブ)', itemPrice: '¥32,000' },
    ]
  },
]; %>

<div class="p-fee-top">
  <div class="p-fee-top__inner c-left-facing-fish l-inner">
    <div class="p-fee-top__section-title">
      <!-- prettier-ignore -->
      <%- include(ejsPath + './component/_c-section-header', {engTitle:
    "Price", jaTitle: "料金一覧"}) %>
    </div>
    <div class="p-fee-top__contentWrapper">
      <div class="p-fee-top__img js-colorbox">
        <picture>
          <source
            srcset="./assets/images/common/Price1.jpg"
            media="(min-width: 768px)"
          />
          <img src="./assets/images/common/Price-sp.jpg" alt="亀の画像" />
        </picture>
      </div>
      <div class="p-fee-top__contents">
        <% contentText.forEach(function(content) { %>
        <div class="p-fee-top__content">
          <h3 class="p-fee-top__title"><%= content.title %></h3>
          <div class="p-fee-top__itemWrapper">
            <% content.items.forEach(function(item) { %>
            <div class="p-fee-top__item">
              <p class="p-fee-top__itemTitle"><%= item.itemTitle %></p>
              <p class="p-fee-top__itemPrice"><%= item.itemPrice %></p>
            </div>
            <% }); %>
          </div>
        </div>
        <% }); %>
      </div>
    </div>
    <div class="p-fee-top__button">
      <!-- prettier-ignore -->
      <%- include(ejsPath + './component/_c-button', {link:'#', text:'View more'}) %>
    </div>
  </div>
</div>
