

<!-- sub-mv -->
<section class="p-sub-mv">
  <div class="p-sub-mv__inner">
    <h1 class="p-sub-mv__title"><%= pageTitle %></h1>
    <picture class="p-sub-mv__img">
      <source srcset="<%= imagePathDesktop %>" media="(min-width: 769px)">
      <img src="<%= imagePathMobile %>" alt="<%= altText %>" loading="lazy" decoding="async">
    </picture>
  </div>
</section>