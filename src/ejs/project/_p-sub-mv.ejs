// 渡されたキーを元にデータを取得
const data = subMvData[subMvDataKey];
if (!data) {
  throw new Error('Invalid subMvDataKey provided.');
}

// 必要なデータを変数に展開
const pageTitle = data.pageTitle;
const images = data.images;
const altText = data.altText || 'デフォルトの代替テキスト'; // altText を取得、存在しない場合はデフォルト値を使用
%>

<!-- sub-mv -->
<section class="sub-mv">
  <div class="sub-mv__inner">
    <h1 class="sub-mv__title"><%= pageTitle %></h1>
    <picture class="sub-mv__img">
      <source srcset="<%= images.desktop %>" media="(min-width: 769px)">
      <img src="<%= images.mobile %>" alt="<%= altText %>" loading="lazy" decoding="async">
    </picture>
  </div>
</section>